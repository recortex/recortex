{
  "description": "Inject the project's record brief from GitHub issues: at session start, resume, clear, compaction and fork; into every subagent; as one line on user prompts when it changed; and as instructions for the compaction summary. Silent unless the project has a .recortex.json file; then a status line is shown to the user at session start (on, or why recortex is off), and the record brief is added only when the user has trusted the repository, except for one fixed line at session start, once per project, in the top folder of a git checkout with a GitHub remote and no setup, offering to set up the record. Experimental observer hooks, off unless enabled for the project folder on this machine, capture bounded transcript pointers and check explicit local holds; without that approval they start no Python. When one of the plugin's own subagents stops, its token counts are kept on this machine for the usage view; nothing is printed. A prompt may also carry one fixed line that the user recorded something in the dashboard since the session's last prompt, and, when the user chose it, one fixed line about work that rests on a decision the record later replaced; no hook is added for either.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/session_start_hook.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_hook.sh subagent-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh subagent-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_hook.sh prompt-submit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_hook.sh pre-compact",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh pre-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh pre-tool",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_pretool_guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_observer_hook.sh stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^recortex:(record-auditor|record-drafter|record-reviewer|record-planner|record-planner-session|ask)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/recortex/scripts/run_hook.sh subagent-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
